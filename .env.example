# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_patient
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/virtual_patient
PRISMA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_patient

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Comma-separated; must include every origin allowed to call the auth API.
TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth (Better Auth social provider)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LangSmith (optional observability)
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Resend (transactional email)
RESEND_API_KEY=
